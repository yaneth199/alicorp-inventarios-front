# INICIAR.bat generates .env with random credentials. Do not commit .env.
POSTGRES_PASSWORD=replace_with_your_own_database_password
SIGPI_ADMIN_PASSWORD=replace_with_your_own_admin_password
SIGPI_DEMO=true
SIGPI_PORT=8080
# Use 0.0.0.0 only to enable access from other PCs on your trusted LAN.
SIGPI_BIND_IP=127.0.0.1
